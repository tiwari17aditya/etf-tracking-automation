# ==============================================================================
# Stock & ETF Quant Research Station - Environment Configuration & Credentials
# ==============================================================================
# Copy this file to .env and fill in your confidential API keys and credentials.
# NOTE: .env is ignored by Git to protect your confidential credentials.
# On Vercel, set these in: Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. SERVER & SYSTEM RUNTIME
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development           # development | production
APP_SECRET_KEY=change-me-to-a-secure-random-secret

# ------------------------------------------------------------------------------
# 2. MARKET DATA & QUANT ENGINE
# ------------------------------------------------------------------------------
DEFAULT_TICKER=GOLDBEES.NS
MARKET_DATA_PROVIDER=yfinance     # yfinance (free, zero-key) | zerodha | angelone
DATA_CACHE_TTL_SECONDS=300        # In-memory quote cache duration (5 mins)

# ------------------------------------------------------------------------------
# 3. AI CO-PILOT / LLM API CREDENTIALS (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional: If you want to connect external frontier LLMs directly
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 4. BROKER & TRADING EXECUTION CREDENTIALS (OPTIONAL)
# ------------------------------------------------------------------------------
# For automated portfolio synchronization or order routing
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_API_KEY=

# ------------------------------------------------------------------------------
# 5. ALERT NOTIFICATIONS (TELEGRAM / DISCORD / EMAIL)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=
