// Prisma schema for Smart Dip Accumulator & Dashboard
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Signal {
  id                  String   @id @default(uuid())
  symbol              String   // GOLDBEES.NS or SILVERBEES.NS
  price               Float
  rsi                 Float
  ema50               Float
  dipDetected         Boolean
  conditionTriggered  String   // e.g. "RSI < 35 & 50-EMA Pullback"
  recommendedAmount   Float    @default(7400) // ₹7,400 from HDFC Sweep-in
  status              String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, EXECUTED, REJECTED, EXPIRED
  alertSent           Boolean  @default(false)
  alertSentAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?  // "UI_DASHBOARD", "EMAIL_ACTION", "CHATBOT_TOOL", "AUTO_RULE"
  executedAt          DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CronRunLog {
  id              String   @id @default(uuid())
  status          String   // SUCCESS, FAILED, NO_CONTENT
  symbolsChecked  String   // "GOLDBEES.NS,SILVERBEES.NS"
  signalsFound    Int      @default(0)
  executionTimeMs Int
  layer1Status    String   @default("HEALTHY") // Ingestion health
  layer2Status    String   @default("HEALTHY") // UI feed cache health
  layer3Status    String   @default("HEALTHY") // AI Guardrails health
  errorMessage    String?
  createdAt       DateTime @default(now())
}

model PortfolioSetting {
  id                   String   @id @default("default")
  sweepInAccountName   String   @default("HDFC Sweep-in Account")
  sweepInBalance       Float    @default(85000)
  defaultDipAmount     Float    @default(7400)
  rsiBuyThreshold      Float    @default(35.0)
  hitlModeEnabled      Boolean  @default(true) // Human-in-the-loop enabled
  autoExecuteBelowRsi  Float    @default(25.0) // Extreme panic dip auto-accumulate
  emailNotifications   Boolean  @default(true)
  recipientEmail       String   @default("investor@example.com")
  updatedAt            DateTime @updatedAt
}
